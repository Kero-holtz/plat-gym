# Local demo mode (no Supabase variables required)
SESSION_SECRET=replace-with-at-least-32-random-bytes
SQLITE_PATH=./data/plat-gym.db
SEED_DEMO_DATA=true

# Production Supabase mode: set all four values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
DATABASE_URL=
DB_SSL=true
DB_POOL_SIZE=5

# Server-only. Use only when running `npm run db:bootstrap:supabase`.
SUPABASE_SERVICE_ROLE_KEY=
BOOTSTRAP_ADMIN_EMAIL=admin@platgym.eg
BOOTSTRAP_ADMIN_NAME=PLAT GYM Manager
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_RECEPTIONIST_EMAIL=reception@platgym.eg
BOOTSTRAP_RECEPTIONIST_NAME=PLAT GYM Reception
BOOTSTRAP_RECEPTIONIST_PASSWORD=
